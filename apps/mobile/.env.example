# Field Capture — environment configuration (Slice 0).
# Copy to `.env.local` (gitignored) and fill in real values locally.
# NEVER commit real Hub URLs, certs, or secrets — none belong in this repo (ADR 001).
#
# APP_ENV selects which Ops Hub a build targets: dev | staging | prod.
# It is set via native build settings (FIELD_APP_ENV in the Xcode build config, surfaced through
# FieldNativeConfig); locally it defaults to "dev".
APP_ENV=dev

# Ops Hub base URLs per environment. The Hub is the source of truth, self-hosted over
# LAN/VPN/HTTPS. Prefer a stable DNS name with public-trust TLS over a pinned self-signed
# cert (ADR 001). These placeholder values are intentionally non-routable.
#
# ON-DEVICE (physical iPhone) TESTING: `localhost` resolves to the PHONE itself, so it will
# NOT reach the Hub. Use this dev machine's LAN IP, e.g. http://192.168.1.149:8000, and make sure the
# Hub is bound to that interface (the opshub dev stack binds 127.0.0.1 by default — see
# docs/iphone-dev-workflow.md §6). `localhost` is correct only for the iOS Simulator running on this
# same machine.
OPS_HUB_URL_DEV=http://localhost:8000
OPS_HUB_URL_STAGING=https://staging-hub.example.invalid
OPS_HUB_URL_PROD=https://hub.example.invalid
