{
  "name": "@fieldcapture/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "react-native start --config metro.config.js",
    "ios": "react-native run-ios --scheme FieldCapture",
    "ios:device": "react-native run-ios --scheme FieldCapture --device",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:check": "react-native bundle --platform ios --dev false --entry-file index.ts --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios"
  },
  "dependencies": {
    "@fieldcapture/contracts": "*",
    "@react-native-community/geolocation": "^3.4.0",
    "base64-js": "^1.5.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-quick-sqlite": "^8.2.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/eslint-config": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@react-native/metro-config": "^0.85.3",
    "@react-native/typescript-config": "^0.85.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "^9.39.4",
    "jest": "~29.7.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|react-native-keychain|react-native-quick-sqlite|react-native-image-picker|react-native-fs|react-native-get-random-values|base64-js|@fieldcapture)/)"
    ]
  }
}
